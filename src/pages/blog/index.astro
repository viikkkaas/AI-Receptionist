---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const pageTitle = 'Blog — CareReceptionist AI | Dental Practice Growth Resources';
const pageDescription = 'Resources for dental practice owners: revenue recovery, AI receptionist guides, and practice management tips from CareReceptionist AI.';

const posts = [
  {
    slug: 'revenue-lost-missed-calls',
    title: 'How Much Revenue Dental Practices Lose to Missed Calls',
    desc: 'Dental practices lose $50K+ per year to missed calls. Calculate your practice\'s revenue leakage and learn how AI receptionists recover that money.',
    tag: 'Revenue',
    date: 'July 2026',
    readTime: '7 min read',
  },
  {
    slug: 'ai-receptionist-dental-clinics-guide',
    title: 'AI Receptionist for Dental Clinics: The Complete Guide',
    desc: 'Everything you need to know about AI receptionists for dental practices: how they work, PMS connectivity for Dentrix, Eaglesoft, and Open Dental, costs, and ROI.',
    tag: 'Guide',
    date: 'July 2026',
    readTime: '10 min read',
  },
  {
    slug: 'dentrix-eaglesoft-ai-integration',
    title: 'Dentrix and Eaglesoft AI Integration Explained',
    desc: 'Technical deep dive on how AI receptionists work with Dentrix and Eaglesoft practice management systems — live sync and one-click confirm workflows for appointment scheduling.',
    tag: 'Integration',
    date: 'July 2026',
    readTime: '8 min read',
  },
];
---

<Layout title={pageTitle} description={pageDescription} canonical="https://www.carereceptionistai.com/blog/">
  <div class="min-h-screen bg-background text-foreground selection:bg-secondary/20 overflow-x-hidden">
    <header class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-lg border-b border-border/80 shadow-sm">
      <nav class="container-custom h-16 flex items-center justify-between">
        <a href="/" class="font-extrabold tracking-tight text-xl flex items-center gap-2 text-primary">
          <span>CareReceptionist</span><span class="text-secondary"> AI</span>
        </a>
        <div class="hidden md:flex items-center gap-4">
          <Button variant="ghost" href="https://app.carereceptionistai.com/login" title="Login" target="_self" />
          <Button title="Book Free Demo" />
        </div>
      </nav>
    </header>

    <main class="pt-32 pb-20">
      <div class="container-custom max-w-4xl">
        <div class="mb-12">
          <a href="/" class="text-sm text-muted-foreground hover:text-secondary transition-colors">&larr; Back to home</a>
          <h1 class="mt-6 text-4xl sm:text-5xl font-black tracking-tight text-primary leading-[1.12]">Blog</h1>
          <p class="mt-3 text-lg text-muted-foreground">Resources for dental practice growth and AI-powered front office operations.</p>
        </div>

        <div class="space-y-8">
          {posts.map((post) => (
            <article class="card-premium p-6 sm:p-8 hover:-translate-y-1 transition-all duration-300">
              <a href={`/blog/${post.slug}/`} class="block">
                <div class="flex items-center gap-3 text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
                  <span class="text-secondary">{post.tag}</span>
                  <span class="w-1 h-1 rounded-full bg-muted-foreground/40"></span>
                  <span>{post.readTime}</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-extrabold text-primary tracking-tight hover:text-secondary transition-colors">{post.title}</h2>
                <p class="mt-3 text-muted-foreground leading-relaxed">{post.desc}</p>
                <div class="mt-4 text-sm text-muted-foreground">{post.date}</div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </main>

    <footer class="bg-primary text-white py-12">
      <div class="container-custom text-center text-sm text-white/50">
        <p>&copy; 2026 CareReceptionist AI. All rights reserved.</p>
      </div>
    </footer>
  </div>
</Layout>
