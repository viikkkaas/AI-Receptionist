---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Page Not Found — CareReceptionist AI';
const pageDescription = 'The page you are looking for does not exist.';
---
<Layout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-background text-foreground selection:bg-secondary/20 overflow-x-hidden">
    <div class="container-custom max-w-2xl mx-auto py-20 text-center">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-primary mb-6">
        404
      </h1>
      <p class="mb-6 text-xl sm:text-2xl text-muted-foreground">
        Page not found
      </p>
      <p class="mb-8 text-lg text-muted-foreground max-w-xl mx-auto leading-relaxed">
        The page you are looking for does not exist or has been moved.
      </p>
      <div class="mt-10">
        <a href="/" class="inline-flex items-center justify-center gap-3 rounded-xl bg-secondary px-8 py-4 text-base sm:text-lg font-black tracking-wide text-white shadow-lg shadow-secondary/25 hover:shadow-xl hover:shadow-secondary/30 hover:scale-[1.03] active:scale-[0.97] transition-all duration-300">
          ← Return to Homepage
          <svg class="w-5 h-5 transform transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</Layout>
